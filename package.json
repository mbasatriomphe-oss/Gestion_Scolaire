{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "next dev",
    "dev:electron": "npm run stage:backend && node scripts/prepare-electron.cjs && concurrently -k \"npm:dev\" \"wait-on http://localhost:3000 && electron .\"",
    "stage:backend": "node scripts/stage-backend.cjs",
    "build": "npm run stage:backend && next build --webpack && node scripts/prepare-electron.cjs",
    "start": "next start",
    "test:desktop": "node --test scripts/desktop-startup.test.cjs",
    "dist:electron": "npm run build && electron-builder --projectDir out",
    "dist": "npm run dist:electron"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.16.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "^19",
    "react-dom": "^19",
    "recharts": "3.8.0",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "wait-on": "^9.5.1"
  }
}
